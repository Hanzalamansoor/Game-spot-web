<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Neon Space Shooter</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            background-color: #050510;
            color: white;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            touch-action: none; /* Prevent scroll on touch devices */
        }
        canvas {
            display: block;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</head>
<body class="relative w-screen h-screen">

    <!-- Score UI -->
    <div class="absolute top-4 left-4 z-10 pointer-events-none">
        <div class="text-gray-400 text-sm tracking-widest uppercase mb-1">Score</div>
        <div id="scoreEl" class="text-4xl font-bold text-white tracking-wider">0</div>
    </div>

    <!-- Start / Game Over Screen -->
    <div id="ui-container" class="absolute inset-0 flex items-center justify-center z-20">
        <div class="glass-panel p-10 rounded-2xl text-center max-w-sm w-full mx-4 shadow-2xl">
            <h1 id="titleEl" class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-500 mb-2">NEON SHOOTER</h1>
            <p id="descEl" class="text-gray-400 mb-8 text-sm">Drag to move. Auto-fire is ON.<br>Survive as long as you can!</p>
            
            <div id="final-score-container" class="hidden mb-8">
                <div class="text-gray-400 text-sm uppercase">Final Score</div>
                <div id="finalScoreEl" class="text-5xl font-bold text-white">0</div>
            </div>

            <button id="startBtn" class="w-full py-4 px-6 rounded-full bg-gradient-to-r from-cyan-500 to-purple-600 text-white font-bold tracking-wider hover:from-cyan-400 hover:to-purple-500 transition-all transform hover:scale-105 active:scale-95 shadow-[0_0_20px_rgba(6,182,212,0.5)]">
                START GAME
            </button>
        </div>
    </div>

    <!-- Game Canvas -->
    <canvas id="gameCanvas"></canvas>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const scoreEl = document.getElementById('scoreEl');
        const startBtn = document.getElementById('startBtn');
        const uiContainer = document.getElementById('ui-container');
        const finalScoreContainer = document.getElementById('final-score-container');
        const finalScoreEl = document.getElementById('finalScoreEl');
        const titleEl = document.getElementById('titleEl');
        const descEl = document.getElementById('descEl');

        // Resize canvas to fill window
        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resize);
        resize();

        // Game State
        let animationId;
        let score = 0;
        let gameActive = false;
        let frameCount = 0;
        let difficultyMultiplier = 1;

        // Entities
        let player;
        let projectiles = [];
        let enemies = [];
        let particles = [];
        let stars = [];

        // Colors
        const neonColors = ['#0ff', '#f0f', '#ff0', '#0f0', '#ff3366'];

        // --- Classes ---

        class Player {
            constructor(x, y, radius, color) {
                this.x = x;
                this.y = y;
                this.radius = radius;
                this.color = color;
                this.targetX = x;
            }

            draw() {
                ctx.save();
                ctx.beginPath();
                // Draw a sleek ship shape (triangle)
                ctx.moveTo(this.x, this.y - this.radius);
                ctx.lineTo(this.x + this.radius * 0.8, this.y + this.radius);
                ctx.lineTo(this.x - this.radius * 0.8, this.y + this.radius);
                ctx.closePath();
                
                ctx.shadowBlur = 20;
                ctx.shadowColor = this.color;
                ctx.fillStyle = this.color;
                ctx.fill();
                ctx.restore();
            }

            update() {
                // Smooth movement towards target (mouse/touch)
                this.x += (this.targetX - this.x) * 0.1;
                
                // Keep within bounds
                if (this.x < this.radius) this.x = this.radius;
                if (this.x > canvas.width - this.radius) this.x = canvas.width - this.radius;
                
                this.draw();
            }
        }

        class Projectile {
            constructor(x, y, velocity, color) {
                this.x = x;
                this.y = y;
                this.velocity = velocity;
                this.color = color;
                this.radius = 3;
            }

            draw() {
                ctx.save();
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2, false);
                ctx.fillStyle = '#fff';
                ctx.shadowBlur = 10;
                ctx.shadowColor = this.color;
                ctx.fill();
                ctx.restore();
            }

            update() {
                this.x += this.velocity.x;
                this.y += this.velocity.y;
                this.draw();
            }
        }

        class Enemy {
            constructor(x, y, radius, color, velocity) {
                this.x = x;
                this.y = y;
                this.radius = radius;
                this.color = color;
                this.velocity = velocity;
                this.edges = Math.floor(Math.random() * 4) + 3; // 3 to 6 sides
                this.angle = 0;
                this.rotationSpeed = (Math.random() - 0.5) * 0.05;
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate(this.angle);
                ctx.beginPath();
                
                // Draw polygon
                for (let i = 0; i < this.edges; i++) {
                    const theta = (i / this.edges) * Math.PI * 2;
                    const vx = Math.cos(theta) * this.radius;
                    const vy = Math.sin(theta) * this.radius;
                    if (i === 0) ctx.moveTo(vx, vy);
                    else ctx.lineTo(vx, vy);
                }
                ctx.closePath();
                
                ctx.strokeStyle = this.color;
                ctx.lineWidth = 3;
                ctx.shadowBlur = 15;
                ctx.shadowColor = this.color;
                ctx.stroke();
                
                // Inner fill
                ctx.fillStyle = `rgba(${hexToRgb(this.color)}, 0.2)`;
                ctx.fill();
                ctx.restore();
            }

            update() {
                this.x += this.velocity.x;
                this.y += this.velocity.y;
                this.angle += this.rotationSpeed;
                this.draw();
            }
        }

        class Particle {
            constructor(x, y, velocity, radius, color) {
                this.x = x;
                this.y = y;
                this.velocity = velocity;
                this.radius = radius;
                this.color = color;
                this.alpha = 1;
                this.friction = 0.98;
            }

            draw() {
                ctx.save();
                ctx.globalAlpha = this.alpha;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2, false);
                ctx.fillStyle = this.color;
                ctx.shadowBlur = 10;
                ctx.shadowColor = this.color;
                ctx.fill();
                ctx.restore();
            }

            update() {
                this.velocity.x *= this.friction;
                this.velocity.y *= this.friction;
                this.x += this.velocity.x;
                this.y += this.velocity.y;
                this.alpha -= 0.015;
                this.draw();
            }
        }

        class Star {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 1.5;
                this.speed = this.size * 2;
                this.alpha = Math.random();
            }
            draw() {
                ctx.fillStyle = `rgba(255, 255, 255, ${this.alpha})`;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
            update() {
                this.y += this.speed;
                if (this.y > canvas.height) {
                    this.y = 0;
                    this.x = Math.random() * canvas.width;
                }
                this.draw();
            }
        }

        // --- Helper Functions ---

        function hexToRgb(hex) {
            let result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
            if (!result) {
                // Handle short hex
                if (hex.length === 4) {
                    return `${parseInt(hex[1]+hex[1], 16)}, ${parseInt(hex[2]+hex[2], 16)}, ${parseInt(hex[3]+hex[3], 16)}`;
                }
                return '255, 255, 255';
            }
            return `${parseInt(result[1], 16)}, ${parseInt(result[2], 16)}, ${parseInt(result[3], 16)}`;
        }

        function spawnEnemies() {
            // Spawn rate increases as score goes up
            const spawnRate = Math.max(30, 100 - Math.floor(score / 50));
            
            if (frameCount % spawnRate === 0) {
                const radius = Math.random() * 15 + 10; // 10 to 25
                const x = Math.random() * (canvas.width - radius * 2) + radius;
                const y = -radius;
                const color = neonColors[Math.floor(Math.random() * neonColors.length)];
                
                // Speed increases over time
                const speedY = (Math.random() * 2 + 1) * difficultyMultiplier;
                const speedX = (Math.random() - 0.5) * 1; // Slight horizontal drift
                
                enemies.push(new Enemy(x, y, radius, color, { x: speedX, y: speedY }));
            }
        }

        function createExplosion(x, y, color) {
            const particleCount = 15;
            for (let i = 0; i < particleCount; i++) {
                const speed = Math.random() * 5 + 2;
                const angle = Math.random() * Math.PI * 2;
                particles.push(new Particle(
                    x, y,
                    { x: Math.cos(angle) * speed, y: Math.sin(angle) * speed },
                    Math.random() * 3 + 1,
                    color
                ));
            }
        }

        function initStars() {
            stars = [];
            for (let i = 0; i < 100; i++) {
                stars.push(new Star());
            }
        }

        // --- Core Logic ---

        function init() {
            player = new Player(canvas.width / 2, canvas.height - 50, 15, '#0ff');
            projectiles = [];
            enemies = [];
            particles = [];
            score = 0;
            scoreEl.innerHTML = score;
            frameCount = 0;
            difficultyMultiplier = 1;
            gameActive = true;
            initStars();
            
            uiContainer.classList.add('hidden');
            animate();
        }

        function animate() {
            if (!gameActive) return;
            animationId = requestAnimationFrame(animate);
            frameCount++;

            // Clear screen with a slight trailing effect for motion blur
            ctx.fillStyle = 'rgba(5, 5, 16, 0.3)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Update stars
            stars.forEach(star => star.update());

            player.update();

            // Auto-fire
            if (frameCount % 10 === 0) {
                projectiles.push(new Projectile(
                    player.x, 
                    player.y - player.radius, 
                    { x: 0, y: -8 }, 
                    '#0ff'
                ));
            }

            // Difficulty progression
            difficultyMultiplier = 1 + (score / 1000);

            spawnEnemies();

            // Update Particles
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                if (p.alpha <= 0) {
                    particles.splice(i, 1);
                } else {
                    p.update();
                }
            }

            // Update Projectiles
            for (let i = projectiles.length - 1; i >= 0; i--) {
                const proj = projectiles[i];
                proj.update();

                // Remove off-screen projectiles
                if (proj.y + proj.radius < 0) {
                    projectiles.splice(i, 1);
                }
            }

            // Update Enemies & Collision Detection
            for (let i = enemies.length - 1; i >= 0; i--) {
                const enemy = enemies[i];
                enemy.update();

                // Remove off-screen enemies (player dodged them)
                if (enemy.y - enemy.radius > canvas.height) {
                    enemies.splice(i, 1);
                    continue;
                }

                // Collision: Enemy vs Player
                const distPlayer = Math.hypot(player.x - enemy.x, player.y - enemy.y);
                if (distPlayer - enemy.radius - player.radius < 0) {
                    // Game Over
                    createExplosion(player.x, player.y, player.color);
                    endGame();
                    return; // Stop processing this frame
                }

                // Collision: Enemy vs Projectiles
                for (let j = projectiles.length - 1; j >= 0; j--) {
                    const proj = projectiles[j];
                    const distProj = Math.hypot(proj.x - enemy.x, proj.y - enemy.y);

                    if (distProj - enemy.radius - proj.radius < 0) {
                        // Hit!
                        createExplosion(enemy.x, enemy.y, enemy.color);
                        
                        score += 10;
                        scoreEl.innerHTML = score;

                        // Remove projectile and enemy
                        projectiles.splice(j, 1);
                        enemies.splice(i, 1);
                        break; // Move to next enemy
                    }
                }
            }
        }

        function endGame() {
            gameActive = false;
            cancelAnimationFrame(animationId);
            
            setTimeout(() => {
                uiContainer.classList.remove('hidden');
                titleEl.innerText = 'GAME OVER';
                titleEl.className = 'text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-pink-500 mb-2';
                descEl.classList.add('hidden');
                
                finalScoreContainer.classList.remove('hidden');
                finalScoreEl.innerText = score;
                
                startBtn.innerText = 'PLAY AGAIN';
            }, 1000); // 1 second delay to watch the explosion
        }

        // --- Event Listeners ---

        startBtn.addEventListener('click', init);

        // Input Handling
        function handleMove(e) {
            if (!gameActive) return;
            
            let clientX;
            if (e.touches) {
                clientX = e.touches[0].clientX;
            } else {
                clientX = e.clientX;
            }
            
            player.targetX = clientX;
        }

        // Mouse
        window.addEventListener('mousemove', handleMove);
        
        // Touch (Mobile)
        window.addEventListener('touchmove', handleMove, { passive: false });
        window.addEventListener('touchstart', handleMove, { passive: false });

        // Initial background draw
        initStars();
        ctx.fillStyle = '#050510';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        stars.forEach(star => star.draw());

    </script>
</body>
</html>
